# Copy to .env and edit.

# Required. Shared bearer token for the web UI, API and MCP endpoint (16+ chars):
#   openssl rand -hex 24
SK_TOKEN=change-me

# Host port for the web UI / API / MCP.
SK_PORT=8090

# Where the database and local render sets live on the host.
SK_DATA=./data

# Kist instance render sets are filed into (leave the URL empty to keep renders local).
SK_KIST_URL=http://kist-host:8082
SK_KIST_TOKEN=
SK_KIST_ROOT_FOLDER=SolidCraft

# Optional API tokens: needed for private repos, and GitHub's anonymous rate limit
# (60 requests/hour) is tight for scanning whole accounts.
SK_GITHUB_TOKEN=
# Your Forgejo/Gitea web URL; its token is only ever sent to this host.
SK_FORGEJO_URL=https://forge.example.com
SK_FORGEJO_TOKEN=

# Re-scan sources this often and render changed designs (0 = only on demand).
SK_SCAN_INTERVAL_MINUTES=360

# Most SolidCraft processes rendering one design's frames at once. Extra processes start
# only for slow frames (big designs) and only as many as free memory holds; each loads the
# whole design (a 2,000-body assembly takes ~6.7 GB).
SK_RENDER_PROCESSES=4

# Group id that owns /dev/dri/renderD128 on the host (`getent group render`).
SK_RENDER_GID=992
