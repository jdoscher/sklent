# A render helper's settings: copy to .env.helper beside docker-compose.helper.yml, then
#   docker compose --env-file .env.helper -f docker-compose.helper.yml up -d
# Settings -> Helpers -> "Create helper token" on the server shows these lines filled in.

# The Sklent server, as this machine reaches it.
SK_HELPER_URL=http://sklent-host:8090
# This helper's name in the server's Helpers list.
SK_HELPER_NAME=gpu-box
# A helper token (skh...): it can only claim and report render jobs. Revoke it in
# Settings -> Tokens. Never use the admin token here.
SK_HELPER_TOKEN=

# gpu (default) or software (Mesa lavapipe on the CPU).
SK_RENDERER=gpu
# Most SolidCraft processes for one design's frames (each loads the whole design:
# a 1,400-body assembly takes ~5 GB).
SK_RENDER_PROCESSES=2
# Group id that owns /dev/dri/renderD128 here (`getent group render`).
SK_RENDER_GID=992
